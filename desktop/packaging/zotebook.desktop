[Desktop Entry]
Type=Application
Name=Zotebook
GenericName=Markdown Editor
Comment=A plain editor for folders of Markdown files
Exec=zotebook %F
Icon=zotebook
Terminal=false
Categories=Office;TextEditor;Utility;
MimeType=inode/directory;text/markdown;
StartupWMClass=zotebook
Keywords=markdown;notes;editor;wiki;
